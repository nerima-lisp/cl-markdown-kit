(in-package #:cl-markdown-kit/test)

(describe "Inline parser edge cases"
  (cl-weave:it-each
    (("&")
     ("&x")
     ("&;")
     ("&#")
     ("&#;")
     ("&#x;")
     ("&#12")
     ("&unknown;")
     ("&abcdefghijklmnopqrstuvwxyz123456;"))
    "preserves malformed entity text for ~S"
    (input)
  (let ((literal
          (apply #'concatenate 'string
                 (mapcar #'cl-markdown-kit:text-value
                         (inline-parser-test-parse input)))))
    (expect literal :to-equal input)))
  (it "preserves unresolved inline references and footnotes"
  (let* ((missing-footnote (inline-parser-test-parse "[^missing]"))
         (empty-footnote (inline-parser-test-parse "[^]"))
         (unclosed-footnote (inline-parser-test-parse "[^missing"))
         (blank-reference (inline-parser-test-parse "[   ]"))
         (blank-full-reference (inline-parser-test-parse "[missing][   ]"))
         (unclosed-reference (inline-parser-test-parse "[missing")))
    (expect (and (notany #'(lambda (node)
                             (typep node 'cl-markdown-kit:footnote-reference))
                         missing-footnote)
                 (notany #'(lambda (node)
                             (typep node 'cl-markdown-kit:footnote-reference))
                         empty-footnote)
                 (notany #'(lambda (node)
                             (typep node 'cl-markdown-kit:footnote-reference))
                         unclosed-footnote)
                 (notany #'(lambda (node) (typep node 'cl-markdown-kit:link))
                         blank-reference)
                 (notany #'(lambda (node) (typep node 'cl-markdown-kit:link))
                         blank-full-reference)
                 (notany #'(lambda (node) (typep node 'cl-markdown-kit:link))
                         unclosed-reference))
            :to-be-truthy)))

  (cl-weave:it-each
    (("<tag _name>" t)
     ("<tag :name>" t)
     ("<tag ns:attr=value>" t)
     ("<tag title='value'>" t)
     ("<tag title=bare>" t)
     ("<1tag>" nil)
     ("<tag .name>" nil)
     ("<tag title=>" nil)
     ("<tag title=`value`>" nil)
     ("<tag title='unclosed>" nil)
     ("<tag" nil)
     ("</tag" nil)
     ("<" nil)
     ("<!" nil)
     ("<!D" nil))
    "classifies raw HTML names and attributes for ~S"
    (source expected-html)
  (let* ((nodes (inline-parser-test-parse source))
         (node (first nodes)))
    (expect (if expected-html
                (and (typep node 'cl-markdown-kit:html-inline)
                     (string= (cl-markdown-kit:html-inline-body node)
                              source))
                (notany #'(lambda (candidate)
                            (typep candidate 'cl-markdown-kit:html-inline))
                        nodes))
            :to-be-truthy)))

  (cl-weave:it-each
    (("[x]()" "")
     ("[x](<a\\q>)" "a%5Cq")
     ("[x](a\\" nil)
     ("[x](/ \"title\\" nil)
     ("[x](" nil)
     ("[x](<a" nil)
     ("[x](<a\\" nil))
    "handles empty destinations and dangling escapes in ~S"
    (source expected-destination)
  (if expected-destination
      (let ((link (first (inline-parser-test-parse source))))
        (expect (and (typep link 'cl-markdown-kit:link)
                     (string= (cl-markdown-kit:link-destination link)
                              expected-destination))
                :to-be-truthy))
      (let ((nodes (inline-parser-test-parse source)))
        (expect (notany #'(lambda (node)
                            (typep node 'cl-markdown-kit:link))
                        nodes)
                :to-be-truthy))))

  (cl-weave:it-each
    (("<a_b:value>")
     ("<https://example.com/<x>>")
     ("<a@b..c>"))
    "rejects invalid angle autolinks for ~S"
    (input)
  (let ((nodes (inline-parser-test-parse input)))
    (expect (notany #'(lambda (node)
                        (typep node 'cl-markdown-kit:autolink))
                    nodes)
            :to-be-truthy)))
  (it "bounds bare autolinks and trims URL endings"
    (let* ((url-nodes (inline-parser-test-parse
                       "http://example.com/path<tail"))
           (url (find-if #'(lambda (node) (typep node 'cl-markdown-kit:autolink)) url-nodes))
           (without-entity
             "http://example.com/path;")
           (empty-entity "http://example.com/path&;")
           (invalid-entity "http://example.com/path&x-y;")
           (punctuation "?!."))
      (expect (and url
                   (string= (cl-markdown-kit:autolink-display-text url)
                            "http://example.com/path")
                   (string= (cl-markdown-kit:text-value (car (last url-nodes)))
                            "<tail"))
              :to-be-truthy)
      (expect (list (cl-markdown-kit::%pc-trim-url-end without-entity 0 (length without-entity))
                    (cl-markdown-kit::%pc-trim-url-end empty-entity 0 (length empty-entity))
                    (cl-markdown-kit::%pc-trim-url-end invalid-entity 0 (length invalid-entity))
                    (cl-markdown-kit::%pc-trim-url-end punctuation 0 0)
                    (cl-markdown-kit::%pc-trim-url-end punctuation 0 (length punctuation)))
              :to-equal (list (length without-entity)
                              (length empty-entity)
                              (length invalid-entity) 0 0)))))
