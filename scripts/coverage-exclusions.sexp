;; :kind is top-level-form (whole form), condition-declaration (slot defaults), or defun-header (lambda list). :reproduction paths are repo-relative gate fixtures.
(:kind top-level-form :head "in-package" :reason "Package selection is a compile-time form without an executable coverage location." :reproduction "scripts/coverage-reproductions/in-package.lisp")
(:kind top-level-form :head "defpackage" :reason "Package definitions are compile-time metadata without an executable coverage location." :reproduction "scripts/coverage-reproductions/defpackage.lisp")
(:kind condition-declaration :head "define-condition" :reason "Condition class metadata is expanded during compilation; condition :report functions remain subject to coverage." :reproduction "scripts/coverage-reproductions/define-condition.lisp")
(:kind top-level-form :head "defstruct" :reason "Structure declarations are excluded only when every slot and constructor default is a literal or a symbol declared by a top-level DEFCONSTANT form; runtime defaults remain subject to coverage." :reproduction "scripts/coverage-reproductions/defstruct.lisp")
(:kind top-level-form :head "declaim" :reason "Compiler declarations configure compilation and have no runtime coverage location." :reproduction "scripts/coverage-reproductions/declaim.lisp")
(:kind defun-header :head "defun" :name "make-source-boundary" :reason "Literal keyword defaults have no executable source location." :reproduction "scripts/coverage-reproductions/defun-header.lisp")
(:kind defun-header :head "defun" :name "make-source-buffer" :reason "Keyword defaults are literals or top-level constants; runtime expressions remain subject to coverage." :reproduction "scripts/coverage-reproductions/defun-constant-keyword-defaults.lisp")
(:kind defun-header :head "defun" :name "make-source-format" :reason "Literal keyword defaults have no executable source location." :reproduction "scripts/coverage-reproductions/defun-header.lisp")
(:kind defun-header :head "defun" :name "parse-string" :reason "Literal keyword defaults have no executable source location." :reproduction "scripts/coverage-reproductions/defun-header.lisp")
(:kind defun-header :head "defun" :name "parse-stream" :reason "Literal keyword defaults have no executable source location." :reproduction "scripts/coverage-reproductions/defun-header.lisp")
(:kind defun-header :head "defun" :name "parse-octets" :reason "Literal keyword defaults have no executable source location." :reproduction "scripts/coverage-reproductions/defun-header.lisp")
(:kind defun-header :head "defun" :name "parse" :reason "Literal keyword defaults have no executable source location." :reproduction "scripts/coverage-reproductions/defun-header.lisp")
(:kind defun-header :head "defun" :name "parse-inline" :reason "Literal keyword defaults have no executable source location." :reproduction "scripts/coverage-reproductions/defun-header.lisp")
(:kind defun-header :head "defun" :name "write-html-to-stream" :reason "Literal keyword defaults have no executable source location." :reproduction "scripts/coverage-reproductions/defun-header.lisp")
(:kind defun-header :head "defun" :name "write-html" :reason "Literal keyword defaults have no executable source location." :reproduction "scripts/coverage-reproductions/defun-header.lisp")
(:kind top-level-form :head "define-node" :reason "DEFINE-NODE declarations are excluded only when their expansion is a DEFSTRUCT with literal defaults or defaults that reference symbols declared by a top-level DEFCONSTANT form; runtime defaults remain subject to coverage." :reproduction "scripts/coverage-reproductions/define-node.lisp")
(:kind top-level-form :head "defconstant" :reason "DEFCONSTANT is excluded only with a literal initializer; runtime initializers remain subject to coverage." :reproduction "scripts/coverage-reproductions/defconstant.lisp")
(:kind top-level-form :head "sb-ext:defglobal" :reason "SB-EXT:DEFGLOBAL is excluded only with a literal initializer; runtime initializers remain subject to coverage." :reproduction "scripts/coverage-reproductions/sb-ext-defglobal.lisp")
(:kind top-level-form :head "defvar" :reason "DEFVAR is excluded when it has no initializer or a literal initializer; runtime initializers remain subject to coverage." :reproduction "scripts/coverage-reproductions/defvar.lisp")
(:kind defun-header :head "defun" :name "%pc-parse-title" :reason "Literal keyword defaults in %PC-PARSE-TITLE have no executable source location." :reproduction "scripts/coverage-reproductions/defun-header.lisp")
(:kind defun-header :head "defun" :name "verify-node-dispatches" :reason "The literal :FAMILIES default has no executable source location." :reproduction "scripts/coverage-reproductions/verify-node-dispatches-header.lisp")
(:kind top-level-form :head "verify-node-dispatches-at-compile-time" :reason "Compile-time dispatch assertions expand to NIL and have no runtime coverage location." :reproduction "scripts/coverage-reproductions/verify-node-dispatches-at-compile-time.lisp")
(:kind top-level-form :head "defparameter" :reason "Literal defparameter initializers have no executable expression to cover; non-literal initializers remain subject to coverage." :reproduction "scripts/coverage-reproductions/html5-entity-data.lisp")
(:kind defun-header :head "defun" :name "make-block-parse-result" :reason "The lambda list and literal NIL default are signature metadata without executable source locations." :reproduction "scripts/coverage-reproductions/defun-header.lisp")
(:kind defun-header :head "defun" :name "parse-blocks" :reason "Keyword defaults are literals or top-level constants; runtime expressions remain subject to coverage." :reproduction "scripts/coverage-reproductions/defun-constant-keyword-defaults.lisp")
