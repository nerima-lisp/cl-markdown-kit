(require :asdf)

(asdf:load-system "cl-json-kit")

(defparameter *project-root*
  (truename
   (make-pathname :directory
                  (butlast (pathname-directory *load-truename*))
                  :name
                  nil
                  :type
                  nil
                  :defaults
                  *load-truename*)))

(defparameter *source-url*
  "https://raw.githubusercontent.com/w3c/html/2ef7a579bcfd2693b98df35f20e51dff60e3fbef/entities.json")

(defparameter *source-identifier*
  "w3c/html commit 2ef7a579bcfd2693b98df35f20e51dff60e3fbef")

(defparameter *source-sha256*
  "3d029331b82668ac319bc81802de45b24396df76816d9ba6cf8807c0a1e59a29")

(defparameter *attribution*
  "Copyright © WHATWG.")

(defparameter *license*
  "CC BY 4.0; portions incorporated into source code are BSD 3-Clause.")

(defun project-path (relative-path)
  (merge-pathnames relative-path *project-root*))

(defun read-utf8-file (path)
  (with-open-file (input path :direction :input :external-format :utf-8)
    (with-output-to-string (contents)
      (loop for character = (read-char input nil nil)
            while character
            do (write-char character contents)))))

(defun codepoints-string (codepoints entity-name)
  (with-output-to-string (characters)
    (loop for codepoint across codepoints
          for character = (code-char codepoint)
          do (unless character
               (error "invalid code point: ~S" entity-name)) (write-char
                                                              character
                                                              characters))))

(defun valid-codepoint-p (codepoint)
  (and (integerp codepoint)
       (<= 0 codepoint #x10ffff)
       (not (<= #xd800 codepoint #xdfff))))

(defun source-entries ()
  (let ((source
         (json-kit:parse
          (read-utf8-file (project-path "data/whatwg-entities.json"))
          :duplicate-key-policy
          :last))
        (entries '()))
    (unless (hash-table-p source)
      (error "the entity source must be a JSON object"))
    (maphash
     (lambda (source-name record)
       (unless
           (and (stringp source-name)
                (plusp (length source-name))
                (char= (char source-name 0) #\&))
         (error "invalid entity name: ~S" source-name))
       (when (char= (char source-name (1- (length source-name))) #\;)
         (unless (hash-table-p record)
           (error "invalid entity record: ~S" source-name))
         (multiple-value-bind (codepoints present-p)
             (gethash "codepoints" record)
           (unless
               (and present-p
                    (vectorp codepoints)
                    (not (stringp codepoints))
                    (plusp (length codepoints)))
             (error "missing code points: ~S" source-name))
           (unless (every #'valid-codepoint-p codepoints)
             (error "invalid code point: ~S" source-name))
           (multiple-value-bind (characters characters-present-p)
               (gethash "characters" record)
             (unless
                 (and characters-present-p
                      (stringp characters)
                      (string= characters
                               (codepoints-string codepoints source-name)))
               (error "character sequence mismatch: ~S" source-name)))
           (push (cons (subseq source-name 1) codepoints) entries))))
     source)
    (sort entries #'string< :key #'car)))

(defun render-lisp (entries)
  (with-output-to-string (output)
    (write-line
     ";;; Generated by scripts/generate-html5-entities.lisp. Do not edit by hand."
     output)
    (write-line ";;; Source: w3c/html repository entities.json snapshot."
                output)
    (format output ";;; Source URL: ~A~%" *source-url*)
    (format output ";;; Source identifier: ~A~%" *source-identifier*)
    (format output ";;; Source SHA-256: ~A~%" *source-sha256*)
    (format output ";;; Attribution: ~A~%" *attribution*)
    (format output ";;; License: ~A~%" *license*)
    (write-line
     ";;; Only semicolon-terminated names are stored, as required by CommonMark."
     output)
    (terpri output)
    (write-line "(in-package #:cl-markdown-kit)" output)
    (terpri output)
    (write-line "(defparameter *html5-entities*" output)
    (format output
            "  (let ((table (make-hash-table :test 'equal :size ~D)))~%"
            (length entries))
    (write-line "    (dolist (entry" output)
    (write-line "             '(" output)
    (dolist (entry entries)
      (format output "               (~S " (car entry))
      (loop for codepoint across (cdr entry)
            for first-p = t then nil
            do (unless first-p
                 (write-char #\Space output)) (format output
                                                      "#x~4,'0X"
                                                      codepoint))
      (write-line ")" output))
    (write-line "               ))" output)
    (write-line "      (setf (gethash (car entry) table)" output)
    (write-line "            (map 'string #'code-char (cdr entry))))" output)
    (write-line "    table))" output)))

(defun string-to-utf8-octets (string)
  (sb-ext:string-to-octets string :external-format :utf-8))

(defun read-file-octets (path)
  (with-open-file
      (input path :direction :input :element-type '(unsigned-byte 8))
    (let* ((length (file-length input))
           (octets (make-array length :element-type '(unsigned-byte 8))))
      (unless (= (read-sequence octets input) length)
        (error "could not read file: ~A"
               (enough-namestring path *project-root*)))
      octets)))

(defun write-file-octets (path octets)
  (with-open-file
      (output path
              :direction
              :output
              :if-exists
              :supersede
              :if-does-not-exist
              :create
              :element-type
              '(unsigned-byte 8))
    (write-sequence octets output)))

(defun command-mode ()
  (let ((arguments (cdr sb-ext:*posix-argv*)))
    (cond
      ((member "--help" arguments :test #'string=)
        (write-line "usage: generate-html5-entities.lisp [--check]"
                    *standard-output*)
        :help)
      ((member "-h" arguments :test #'string=)
        (write-line "usage: generate-html5-entities.lisp [--check]"
                    *standard-output*)
        :help)
      ((every
        (lambda (argument)
          (string= argument "--check"))
        arguments)
       (if (member "--check" arguments :test #'string=)
           :check
           :write))
      (t
        (write-line "usage: generate-html5-entities.lisp [--check]"
                    *error-output*)
        (format *error-output*
                "error: unrecognized arguments: ~{~A~^ ~}~%"
                (remove "--check" arguments :test #'string=))
        :invalid))))

(defun main ()
  (let ((mode (command-mode)))
    (case mode
      (:help 0)
      (:invalid 2)
      (otherwise
       (let* ((output-path (project-path "src/html-entities-data.lisp"))
              (expected (string-to-utf8-octets (render-lisp (source-entries)))))
         (if (eq mode :check)
             (let ((actual (read-file-octets output-path)))
               (if (equalp actual expected)
                   (progn
                     (format t
                             "verified src/html-entities-data.lisp (~D bytes)~%"
                             (length expected))
                     0)
                   (progn
                     (format *error-output*
                             "error: src/html-entities-data.lisp is out of date (~D expected bytes, ~D actual bytes)~%"
                             (length expected)
                             (length actual))
                     1)))
             (progn
               (write-file-octets output-path expected)
               (format t
                       "wrote src/html-entities-data.lisp (~D bytes)~%"
                       (length expected))
               0)))))))

(handler-case (sb-ext:exit :code (main))
  (error (condition)
    (format *error-output* "error: ~A~%" condition)
    (sb-ext:exit :code 1)))
